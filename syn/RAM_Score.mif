-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=7;
DEPTH=64;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
	00  :   10;
	01  :   15;
	02  :   20;
	03  :   25;
	04  :   30;
	05  :   35;
	06  :   00;
	07  :   01;
	[08..0D]  :   00;
	0E  :   01;
	[0F..15]  :   00;
	[16..17]  :   01;
	[18..1C]  :   00;
	1D  :   01;
	[1E..24]  :   00;
	25  :   01;
	26  :   00;
	27  :   01;
	[28..3F]  :   00;
END;
